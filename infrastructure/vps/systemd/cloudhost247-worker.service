# CloudHost247 — deployment worker (persistent) under systemd.
# Runs the provisioning/deployment pipelines (npm run worker).
# On cPanel this is `npm run worker:once` via Cron every minute; on the VPS a
# persistent systemd service is preferred (DB-backed leases prevent overlap).
# __APP_ROOT__ / __APP_USER__ are rendered by setup-ubuntu-24.04.sh.
[Unit]
Description=CloudHost247 deployment worker (persistent)
After=network.target postgresql.service cloudhost247-node.service
Wants=postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__
ExecStart=/usr/bin/node dist/src/worker/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

Environment=NODE_ENV=production
Environment=DISABLE_AUTO_BUILD=1
EnvironmentFile=-__APP_ROOT__/.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=__APP_ROOT__ /var/log/cloudhost247

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
