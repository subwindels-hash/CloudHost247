# CloudHost247 — Deployment & provisioning worker under systemd.
# Runs as a persistent supervised service with 5s poll cadence (database-backed
# leases prevent duplicate processing).
[Unit]
Description=CloudHost247 deployment & provisioning worker
After=network.target postgresql.service cloudhost247-node.service
Wants=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__
ExecStartPre=/usr/bin/test -f __APP_ROOT__/dist/src/worker/main.js
ExecStart=/usr/bin/node --max-old-space-size=512 dist/src/worker/main.js

Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM

Environment=NODE_ENV=production
EnvironmentFile=-__APP_ROOT__/.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=__APP_ROOT__ /var/log/cloudhost247

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
