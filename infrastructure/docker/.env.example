# Variables consumed by infrastructure/docker/docker-compose.yml.
# Copy to .env (git-ignored) and fill in. Never commit real values.
#   cp .env.example .env

# Public URL and hostname Traefik routes to the app (DNS A record must point at this server).
APP_URL=https://app.example.com
APP_HOST=app.example.com
# Email used for Let's Encrypt certificate registration.
ACME_EMAIL=admin@example.com

# PostgreSQL (container-internal; not published to the internet).
POSTGRES_DB=cloudhost247
POSTGRES_USER=cloudhost247
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Optional: email relay for verification / password-reset / notification emails.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=

# Optional: infrastructure provider credentials (see cloudhost247-node/.env.example for the full list).
HETZNER_API_TOKEN=
DIGITALOCEAN_API_TOKEN=
VULTR_API_KEY=
