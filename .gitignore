# Never commit archives or secrets
*.zip
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
desktop.ini
Thumbs.db

# WHMCS production configuration (contains DB credentials & license key)
configuration.php

# WHMCS runtime directories (created at runtime, must not be committed)
/templates_c/
/attachments/
/downloads/

__pycache__/
*.py[cod]

# Convenience symlink to cloudhost247-node/node_modules so tooling run from the repository
# root (e.g. recovery/verify-financial-invariants.ts) can resolve dependencies.
/node_modules

# Build tooling for scripts/php-wasm (installed on first use; never shipped)
/scripts/php-wasm/node_modules/
/scripts/php-wasm/.install-lock/

# Local verification logs, caches and downloaded tooling (never release inputs).
/.cache/
