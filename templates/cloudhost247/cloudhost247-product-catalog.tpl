<main id="main-content">{include file="cloudhost247/includes/product-hero.tpl"}<section id="catalog-plans" class="ch247-catalog" aria-labelledby="catalog-title"><header class="ch247-catalog__header"><h2 id="catalog-title">Cloud hosting plans</h2><p>Choose a verified, currently available CloudHost247 plan. Configuration and checkout remain securely handled by WHMCS.</p><nav aria-label="Product type"><a href="cloudhost247-hosting.php">All</a><a href="cloudhost247-hosting.php?type=hosting">Hosting</a><a href="cloudhost247-hosting.php?type=vps">VPS</a><a href="cloudhost247-hosting.php?type=dedicated">Dedicated servers</a></nav></header>{if $ch247CatalogError}<div class="alert alert-warning" role="alert">{$ch247CatalogError|escape}</div>{/if}<div class="ch247-product-grid">{foreach $ch247Products as $product}<article class="ch247-product-card{if $product.featured} ch247-product-card--featured{/if}"><header><p class="ch247-product-card__kind">{$product.kind|capitalize|escape}</p><h2>{$product.name|escape}</h2><p>{$product.description|escape}</p><span class="label label-info">{$product.availability|capitalize|escape}</span></header><h3>Specifications</h3><dl>{foreach $product.specifications as $label=>$value}{if $value}<dt>{$label|replace:'_':' '|capitalize|escape}</dt><dd>{$value|escape}</dd>{/if}{/foreach}</dl><h3>Pricing</h3>{if $product.pricing}<div class="table-responsive"><table class="table"><caption class="sr-only">Verified {$product.currency|escape} pricing for {$product.name|escape}</caption><tbody>{foreach $product.pricing as $cycle=>$price}<tr><th scope="row">{$cycle|capitalize|escape}</th><td>{$product.prefix|escape}{$price|escape}{$product.suffix|escape} {$product.currency|escape}</td></tr>{/foreach}</tbody></table></div>{else}<p><strong>Pricing: NOT VERIFIED</strong></p>{/if}<a class="btn btn-primary btn-block" href="{$product.cart_url|escape}">Configure in WHMCS</a></article>{foreachelse}<p>No verified available products match this selection.</p>{/foreach}</div></section>{include file="cloudhost247/includes/site-cta.tpl"}</main>
