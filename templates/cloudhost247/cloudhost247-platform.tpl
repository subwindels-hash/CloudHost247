</div></section>{if $ch247Site.path == 'operating-systems.php'}<section class="ch-section" id="families"><div class="ch-wrap"><p class="ch-kicker">Image families</p><h2>Families an operator can map.</h2><p>These names are catalogue families. A family is available only when the connected platform returns it. This list is not stock.</p><div class="ch-tool-related"><a id="ubuntu" href="#ubuntu">Ubuntu</a><a id="debian" href="#debian">Debian</a><a id="almalinux" href="#almalinux">AlmaLinux</a><a id="rocky" href="#rocky">Rocky Linux</a><a id="windows" href="#windows">Windows Server</a><a id="wordpress" href="#wordpress">WordPress</a><a id="docker" href="#docker">Docker</a><a id="lamp" href="#lamp">LAMP</a><a id="lemp" href="#lemp">LEMP</a><a id="cpanel" href="#cpanel">cPanel</a><a id="plesk" href="#plesk">Plesk</a></div></div></section>{/if}
{if $ch247Site.path == 'applications.php'}<section class="ch-section"><div class="ch-wrap" data-ch-manifests><p class="ch-kicker">Application directory</p><h2>Explore the manifest catalogue.</h2><p>These are the application manifests shipped with CloudHost247, not a claim of deployment availability. An eligible service and a published live application version are required to install. Third-party names identify software; marks are neutral CloudHost247 monograms.</p><div class="ch-catalog-controls"><label>Search applications<input type="search" data-manifest-search maxlength="100" placeholder="Name, category or description"></label><label>Category<select data-manifest-category><option value="">All categories</option></select></label></div><p role="status" data-manifest-status></p><div class="ch-grid-3">{foreach $ch247Site.applicationManifests as $app}<article class="ch-plan" data-manifest-card data-category="{$app.category|escape}"><img src="{$WEB_ROOT}/assets/images/cloudhost247/{$app.mark|escape}" width="64" height="64" alt="" loading="lazy"><p class="ch-kicker">{$app.category|escape}</p><h3>{$app.name|escape}</h3><p>{$app.description|escape}</p><dl><dt>Manifest versions</dt><dd>{foreach $app.versions as $version}{$version|escape}{if !$version@last}, {/if}{/foreach}</dd><dt>Deployment method</dt><dd>{$app.deployment|escape}</dd><dt>Minimum resources</dt><dd>{$app.requirements.cpu|escape} CPU · {$app.requirements.memory|escape} MB RAM · {$app.requirements.storage|escape} MB storage</dd><dt>Compatible hosting types</dt><dd>{foreach $app.relatedHosting as $type}{$type|escape}{if !$type@last}, {/if}{/foreach}</dd></dl><p class="ch-note">Manifest available. Confirm eligibility with the live platform before deployment.</p>{if $ch247Site.platform}<a class="ch-text-link" href="{$ch247Site.platform|escape}/apps/{$app.slug|escape}">Versions &amp; deployment requirements →</a>{else}<a class="ch-text-link" href="{$WEB_ROOT}/contact.php">Discuss application hosting →</a>{/if}</article>{/foreach}</div></div></section>{/if}
