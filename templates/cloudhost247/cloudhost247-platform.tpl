<div data-ch-catalog="{if $ch247Site.path == 'operating-systems.php'}os{else}apps{/if}" data-platform="{$ch247Site.platform|escape}"><p class="ch-kicker">Live platform catalog</p><h2>{if $ch247Site.path == 'operating-systems.php'}Verified image families{else}Configured applications{/if}</h2><p data-catalog-status role="status">Loading the connected platform catalog…</p><div class="ch-grid-3" data-catalog-results></div><noscript><p>Open the platform catalog to view current availability.</p></noscript><a class="ch-btn ch-btn-dark" href="{$ch247Site.platform|escape}/{if $ch247Site.path == 'operating-systems.php'}servers/new{else}apps{/if}">Open Platform →</a></div>
