<main id="main-content" class="ch247-page">
<article><header><h1>{$cloudhost247Page.title|escape}</h1>{if $cloudhost247Page.summary}<p class="lead">{$cloudhost247Page.summary|escape}</p>{/if}</header><div class="ch247-page__body">{$cloudhost247Page.body nofilter}</div>{if $cloudhost247Page.product_component}<section class="ch247-section" aria-label="Available plans">{if not $cloudhost247Page.product_component.available}<p class="alert alert-warning" role="alert">{$cloudhost247Page.product_component.reason|escape}</p>{elseif $cloudhost247Page.product_component.products}<div class="ch247-grid">{foreach $cloudhost247Page.product_component.products as $product}<article class="ch247-card"><h2>{$product.name|escape}</h2><p>{$product.description|escape}</p>{if $product.price}<p><strong>{$product.price.formatted|escape}</strong> <span>{$product.price.currency|escape}</span></p>{else}<p><strong>Price not published</strong></p>{/if}<a class="ch247-button" href="{$product.order_url|escape:'html'}">Order</a></article>{/foreach}</div>{else}<p>No published plans are available in this group.</p>{/if}</section>{/if}</article>
</main>
