# ---------------------------------------------------------------------------
# CloudHost247 platform — environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and edit. The platform reads this file itself (src/core/config.js)
# — there is no dotenv dependency.
#
# RULE: no secret has a hardcoded fallback. Missing secrets fail startup loudly,
# except in NODE_ENV=development where an ephemeral in-memory secret is derived
# so a fresh checkout boots (a warning is logged every start).

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# Leave DATABASE_URL empty/unset to use the zero-dependency JSON file store.
# Set it to a postgres:// or postgresql:// URL to switch to PostgreSQL (pg@8.16.3).
#
# DATABASE_URL=postgresql://user:pass@localhost:5432/cloudhost247
DATA_DIR=./data
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# --- Auth ------------------------------------------------------------------
# Minimum 32 characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Ops -------------------------------------------------------------------
LOG_LEVEL=info
CRON_JOB_TOKEN=

# --- Public site / SPA -----------------------------------------------------
PUBLIC_DIR=./public
SPA_DIR=./spa/dist
STATIC_MAX_AGE=3600

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# --- Payments (optional) ---------------------------------------------------
# Instructions shown to a customer who chooses the manual (bank transfer) gateway. With no value the
# gateway returns an honest "contact support" message instead of inventing bank details.
MANUAL_PAYMENT_INSTRUCTIONS=
# Secret the self-contained sandbox gateway signs its simulated deliveries with. Unset disables
# sandbox completion.
SANDBOX_GATEWAY_WEBHOOK_SECRET=

# --- Real payment providers: inbound webhook verification (optional) --------
# Each value enables *receiving* verified deliveries from that provider. The receiver for an
# unconfigured provider refuses every delivery with a 401 naming the variable rather than accepting
# an unverifiable body. Starting a checkout with these providers additionally needs live provider
# egress, which this build does not have, so initiation is refused with that reason.
# Stripe: the endpoint's signing secret (whsec_...) used for the Stripe-Signature HMAC.
STRIPE_WEBHOOK_SECRET=
# PayPal: the webhook id PayPal assigns to the endpoint; certificates are fetched from PayPal's
# allowlisted hosts only (SSRF-guarded, redirects disabled, cached in memory).
PAYPAL_WEBHOOK_ID=
# Paystack: the account secret key (sk_...), which is also the HMAC-SHA512 key for
# x-paystack-signature.
PAYSTACK_SECRET_KEY=
