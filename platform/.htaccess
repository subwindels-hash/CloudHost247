# CloudHost247 Platform — cPanel / Phusion Passenger compatible .htaccess
#
# IMPORTANT: Do NOT hardcode PassengerAppRoot, PassengerNodejs, or RewriteRule
# proxies to 127.0.0.1:3000 here. cPanel's "Setup Node.js App" (CloudLinux
# Passenger / LiteSpeed lsnode) automatically manages and injects its own
# `# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION` block with the exact
# account path, Node binary, and dynamic socket/port. Hardcoding placeholder
# paths or proxying to port 3000 overrides Passenger and causes HTTP 503 errors.

# Disable directory listing
Options -Indexes

# Protect environment and VCS metadata files from direct web access
<FilesMatch "^\.(env|env\..*|git|gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^package(-lock)?\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
