{
  "appId": "com.cloudhost247.app",
  "appName": "CloudHost247",
  "webDir": "../spa/dist",
  "backgroundColor": "#0a1620",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*.cloudhost247.example.com"]
  },
  "plugins": {
    "CloudHost247": {
      "apiOrigin": ""
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#16704b",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#16704b"
    }
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": true
  }
}
