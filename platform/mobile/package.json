{
  "name": "cloudhost247-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "CloudHost247 native Android/iOS shells via Capacitor, wrapping the React SPA in mobile/resources.",
  "scripts": {
    "build:web": "npm --prefix ../spa run build",
    "sync": "npm run build:web && cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
