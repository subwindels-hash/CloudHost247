# CloudHost247 Node platform — environment variables.
#
# This file lists variable NAMES only. Never commit real values.
#
# On cPanel: configure these through the "Setup Node.js App" screen's environment variable
# editor (preferred), or via a .env file placed in the application root and excluded from Git.
# After changing any of these, restart the application from cPanel's Application Manager.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
# Do NOT set PORT on cPanel — Passenger/Application Manager assigns and injects it automatically.
# PORT is only useful for local development (npm run dev), where it defaults to 3000.
PORT=3000
APP_URL=https://cloudhost247.com

# --- Database ------------------------------------------------------------
# Single connection string. Use the database created via cPanel's "PostgreSQL Databases" tool if
# the hosting account provides PostgreSQL, otherwise use a properly secured external/managed
# PostgreSQL provider. Never split this into separate hardcoded host/user/password constants.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Scheduled jobs (reserved for Phase 2+ cron/webhook endpoints) --------
CRON_JOB_TOKEN=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Credential encryption (Phase 6 — REQUIRED in production) ----------------
# Encrypts agent secrets, WHM API tokens, and per-installation environment values
# at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotation: set CREDENTIAL_ENCRYPTION_KEYS to a versioned ring and keep old keys
# until every envelope has been re-encrypted (admin → Servers → rotate).
CREDENTIAL_ENCRYPTION_KEY=
# CREDENTIAL_ENCRYPTION_KEYS=1:<hex64>,2:<hex64>

# --- Deployment engine / worker (Phase 6) -----------------------------------
# Simulation mode runs the full deployment pipelines without contacting agents
# (useful for staging and demos). NEVER enable in production.
DEPLOYMENT_SIMULATION_MODE=false
# The optional Kubernetes adapter is OFF by default; only enable on clusters
# actually configured for the platform (docs/DEPLOYMENT_ENGINES.md).
KUBERNETES_ADAPTER_ENABLED=false
# Worker process tuning (npm run worker) — see docs/DEPLOYMENT_PIPELINE.md.
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=120000

# --- Off-server backups (Phase 6 — required for scheduled backups) -----------
# S3-compatible object storage for upload of server-agent archives (AWS S3,
# Cloudflare R2, Wasabi, MinIO). Leaving these unset disables off-server upload;
# scheduled backups then stay on the application server only (not recommended).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
