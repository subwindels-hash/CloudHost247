# CloudHost247 Node platform — environment variables.
#
# This file lists variable NAMES only. Never commit real values.
#
# On cPanel: configure these through the "Setup Node.js App" screen's environment variable
# editor (preferred), or via a .env file placed in the application root and excluded from Git.
# After changing any of these, restart the application from cPanel's Application Manager.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
# Do NOT set PORT on cPanel — Passenger/Application Manager assigns and injects it automatically.
# PORT is only useful for local development (npm run dev), where it defaults to 3000.
PORT=3000
APP_URL=https://cloudhost247.com

# --- Database ------------------------------------------------------------
# Single connection string. Use the database created via cPanel's "PostgreSQL Databases" tool if
# the hosting account provides PostgreSQL, otherwise use a properly secured external/managed
# PostgreSQL provider. Never split this into separate hardcoded host/user/password constants.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Scheduled jobs (reserved for Phase 2+ cron/webhook endpoints) --------
CRON_JOB_TOKEN=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Credential encryption (Phase 6 — REQUIRED in production) ----------------
# Encrypts agent secrets, WHM API tokens, per-installation environment values, and TOTP MFA
# seeds at rest (AES-256-GCM). TOTP enrollment fails closed until a key is configured. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotation: set CREDENTIAL_ENCRYPTION_KEYS to a versioned ring and keep old keys
# until every envelope has been re-encrypted (admin → Servers → rotate).
CREDENTIAL_ENCRYPTION_KEY=
# CREDENTIAL_ENCRYPTION_KEYS=1:<hex64>,2:<hex64>

# --- Deployment engine / worker (Phase 6) -----------------------------------
# Simulation mode runs the full deployment pipelines without contacting agents
# (useful for staging and demos). NEVER enable in production.
DEPLOYMENT_SIMULATION_MODE=false
# The optional Kubernetes adapter is OFF by default; only enable on clusters
# actually configured for the platform (docs/DEPLOYMENT_ENGINES.md).
KUBERNETES_ADAPTER_ENABLED=false
# Worker process tuning (npm run worker) — see docs/DEPLOYMENT_PIPELINE.md.
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=120000
# cPanel Cron should run `npm run worker:once` every minute. This flag is an alternative for
# schedulers that cannot pass --once; never set it on a supervised persistent worker.
WORKER_ONCE=false
# One-shot cycles take this DB-backed lease and renew it while they run, so overlapping Cron
# invocations skip periodic sweeps safely rather than running them twice.
WORKER_ONCE_LEASE_MS=900000

# --- Off-server backups (Phase 6 — required for scheduled backups) -----------
# S3-compatible object storage for upload of server-agent archives (AWS S3,
# Cloudflare R2, Wasabi, MinIO). Leaving these unset disables off-server upload;
# scheduled backups then stay on the application server only (not recommended).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Infrastructure providers / OS provisioning ----------------------------------
# Configure only providers enabled in Admin → Infrastructure. No provider is auto-selected.
HETZNER_API_URL=https://api.hetzner.cloud/v1
HETZNER_API_TOKEN=
DIGITALOCEAN_API_URL=https://api.digitalocean.com/v2
DIGITALOCEAN_API_TOKEN=
VULTR_API_URL=https://api.vultr.com/v2
VULTR_API_KEY=
# Amazon EC2 (native SDK adapter)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Contabo Compute API (native OAuth2 adapter). The token endpoint is optional unless Contabo
# supplies an account-specific endpoint. Keep all credential values server-side.
CONTABO_API_URL=https://api.contabo.com/v1
CONTABO_TOKEN_URL=https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
# OVHcloud Public Cloud (signed v1 API)
OVH_API_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_CLOUD_PROJECT_ID=
# Proxmox VE (self-hosted; set the https API URL on the provider row or here)
PROXMOX_API_URL=
PROXMOX_API_TOKEN=
# Virtualizor admin API (self-hosted)
VIRTUALIZOR_API_URL=
VIRTUALIZOR_API_KEY=
VIRTUALIZOR_API_SECRET=
# SolusVM 1 admin API (self-hosted)
SOLUSVM_API_URL=
SOLUSVM_API_ID=
SOLUSVM_API_KEY=
# OpenStack: either Keystone v3 password login or a pre-issued token + Nova endpoint
OPENSTACK_AUTH_URL=
OPENSTACK_USERNAME=
OPENSTACK_PASSWORD=
OPENSTACK_PROJECT_ID=
OPENSTACK_PROJECT_NAME=
OPENSTACK_USER_DOMAIN_NAME=Default
OPENSTACK_PROJECT_DOMAIN_NAME=Default
OPENSTACK_REGION=
OPENSTACK_API_URL=
OPENSTACK_IMAGE_URL=
OPENSTACK_API_TOKEN=
# Operator-owned HTTPS provider bridge (generic_http adapter). A custom provider prefix may be
# used instead; its `<PREFIX>_API_TOKEN` must also be passed to both app and worker containers.
PROVIDER_BRIDGE_API_TOKEN=
# Development-only mock provider. Never honoured when NODE_ENV=production.
ALLOW_MOCK_PROVIDER=false
# HTTPS URL to a self-contained, operator-controlled CloudHost247 server-agent installer.
# Provisioning fails closed until the authenticated agent reports OS/security/monitoring health.
SERVER_AGENT_INSTALL_URL=
PROVISIONING_HEALTH_TIMEOUT_MS=600000

# Optional email-delivery bridge. In-app notifications and security-sensitive verification/reset
# messages are durable worker queues; while these values are absent their rows sit visibly in
# CONFIGURATION_REQUIRED and are only sent once you configure the operator-owned relay. The app
# never claims that an email was delivered merely because it accepted a request.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=

# --- Global platform services (Website Builder, Online Store, Logo Maker, Experts, Marketing,
#     Unified Inbox) ---------------------------------------------------------------------------
# Inbound webhook secret for the Unified Inbox. While it is unset the inbound endpoint answers
# 503 CONFIGURATION_REQUIRED instead of accepting unauthenticated messages; nothing is lost, the
# channel is simply reported as "not connected" with this variable named as what is missing.
INBOX_INBOUND_WEBHOOK_SECRET=
# Optional OpenAI-compatible model provider for the AI Website Builder and the Logo Maker palette
# suggestion. Both features work fully without it (the built-in generator and the design catalogue
# are always available); without these values an AI request is refused with a message naming the
# missing configuration rather than silently substituting another engine.
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=
# AI_LLM_API_KEY=
# AI_LLM_API_STYLE=openai
# AI_LLM_TIMEOUT_MS=60000
# Absolute base URL of the public site, used for build-time metadata when the bundle is evaluated
# outside a browser. In the browser the deployed origin is used automatically, so this is optional.
VITE_SITE_URL=https://cloudhost247.com

# --- Payment provider webhooks (signature verification) ---------------------------------------
# Each gateway accepts a verified webhook only when its secret is configured; until then settlement
# happens through the existing manual/invoice flow and the gateway is reported as not connected.
STRIPE_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=
PAYSTACK_SECRET_KEY=
SANDBOX_GATEWAY_WEBHOOK_SECRET=
# Copy shown to a customer who chooses "manual payment" at checkout (bank/transfer details).
MANUAL_PAYMENT_INSTRUCTIONS=

# --- Cloudflare (DNS/CDN integration for the domains the platform manages) ---------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# --- Marketplace ------------------------------------------------------------------------------
MARKETPLACE_MANIFESTS_DIR=
