{
  "name": "cloudhost247-node",
  "version": "0.1.0",
  "private": true,
  "description": "CloudHost247 independent Node.js/TypeScript platform (cPanel Passenger deployable). Replaces the WHMCS-dependent stack incrementally per docs/CPANEL_DEPLOYMENT.md.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n server,frontend -c blue,green \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:stack": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "tsx watch scripts/dev-server.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "npm run typecheck:scripts && npm run tools:catalog:check && npm run build:server && npm run build:frontend && npm run build:tools",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "start": "node server.js",
    "worker": "node dist/src/worker/main.js",
    "worker:once": "node dist/src/worker/main.js --once",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/database/migrate.js up",
    "migrate:status": "node dist/database/migrate.js status",
    "migrate:verify": "node dist/database/migrate.js verify",
    "migrate:create": "node dist/database/migrate.js create",
    "env:check": "node dist/src/config/check-env.js",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:docs": "tsx scripts/generate-tools-catalog-doc.ts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "verify:financial": "tsx tools/verify-financial-invariants.ts",
    "verify:authorization": "tsx tools/verify-payment-authorization.ts",
    "whmcs:map": "tsx scripts/whmcs/catalogue-map.ts",
    "tools:catalog": "tsx scripts/export-tools-site.ts",
    "tools:catalog:check": "tsx scripts/export-tools-site.ts --check",
    "tools:preview": "tsx scripts/tools-demo-preview.ts",
    "preview": "tsx scripts/tools-preview-server.ts",
    "build:tools": "vite build --config frontend/vite.tools.config.ts",
    "e2e": "playwright test",
    "evidence:screenshots": "node scripts/capture-rendered-pages.mjs",
    "evidence:layout": "node scripts/check-header-layout.mjs",
    "evidence:chrome": "node scripts/capture-chrome-benchmark.mjs",
    "check:chrome": "node scripts/check-chrome-benchmark.mjs",
    "check:3d": "node scripts/check-3d-experience.mjs",
    "whmcs:discover": "tsx scripts/whmcs/catalogue-map.ts discover",
    "whmcs:doctor": "tsx scripts/whmcs/catalogue-map.ts doctor",
    "whmcs:review": "tsx scripts/whmcs/catalogue-map.ts review",
    "whmcs:validate": "tsx scripts/whmcs/catalogue-map.ts validate",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "whmcs:evidence": "tsx scripts/whmcs/catalogue-map.ts evidence",
    "whmcs:readiness": "tsx scripts/whmcs/catalogue-map.ts readiness",
    "test:patroni-integration": "vitest run tests/integration/design-studio-templates-patroni-gate.test.ts --testTimeout=600000 --hookTimeout=600000",
    "test:recovery-integration": "vitest run tests/integration/design-studio-templates-recovery-fencing.test.ts --testTimeout=900000 --hookTimeout=900000",
    "test:boundary-integration": "vitest run tests/integration/design-studio-templates-startup-boundary.test.ts --testTimeout=900000 --hookTimeout=900000"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1144.0",
    "@aws-sdk/client-ec2": "3.1144.0",
    "@aws-sdk/client-ec2-instance-connect": "3.1144.0",
    "@aws-sdk/client-route-53": "^3.1144.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@mediabunny/flac-encoder": "1.65.2",
    "@mediabunny/mp3-encoder": "1.65.2",
    "@napi-rs/canvas": "^0.1.100",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "fflate": "0.8.3",
    "flag-icons": "^7.6.0",
    "geoip-lite": "^1.4.10",
    "gifenc": "1.0.3",
    "heic2any": "0.0.4",
    "ipaddr.js": "^2.5.0",
    "iso-3166-1": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "mediabunny": "1.65.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "pngjs": "^7.0.0",
    "qpdf-run": "0.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.2.7",
    "@playwright/test": "^1.64.0",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vite": "^6.4.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "geoip-lite": {
      "ip-address": "^10.7.6"
    }
  }
}
