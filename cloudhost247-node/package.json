{
  "name": "cloudhost247-node",
  "version": "0.1.0",
  "private": true,
  "description": "CloudHost247 independent Node.js/TypeScript platform (cPanel Passenger deployable). Replaces the WHMCS-dependent stack incrementally per docs/CPANEL_DEPLOYMENT.md.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n server,frontend -c blue,green \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "start": "node server.js",
    "worker": "node dist/src/worker/main.js",
    "worker:once": "node dist/src/worker/main.js --once",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/database/migrate.js up",
    "migrate:status": "node dist/database/migrate.js status",
    "migrate:verify": "node dist/database/migrate.js verify",
    "migrate:create": "node dist/database/migrate.js create",
    "env:check": "node dist/src/config/check-env.js",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:import": "tsx scripts/import-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1144.0",
    "@aws-sdk/client-route-53": "3.1144.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.7",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vite": "^6.4.2",
    "vitest": "^5.0.2"
  }
}
