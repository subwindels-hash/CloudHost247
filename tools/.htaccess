# Scoped to /tools only; never intercepts WHMCS account/cart routes.
Options -Indexes
DirectoryIndex index.php
DirectorySlash Off
RewriteEngine On
RewriteRule ^data/ - [F]
RewriteRule ^index\.php$ - [END]
RewriteRule ^api\.php$ - [END]
RewriteRule ^admin(?:/|$) - [END]
RewriteRule ^ index.php [END]
